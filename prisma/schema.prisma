generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  username        String           @unique
  passwordHash    String
  rol             Rol
  activo          Boolean          @default(true)
  email           String?          @unique
  cedula          String
  nombres         String
  primerApellido  String
  segundoApellido String?
  profesion       Profesion
  telefono        String?
  fotoCarnet      String?
  consentimientos Consentimiento[]
  novedades       Novedad[]
  rondas          RondaIntramural[]
  boletines       Boletin[]
  registrosHeridas ClinicaHeridas[]
  consultasHeridas ClinicaHeridasConsulta[]
}

/// Paciente de la Clinica de Heridas.
///
/// PRIVACIDAD: no guarda ningun dato personal. Solo la referencia opaca del
/// Bridge y el identificador -- tambien opaco -- de su carpeta en SharePoint.
/// El nombre y el documento que dan nombre a esa carpeta viajan en memoria
/// durante la peticion que la crea y no se persisten en Neon.
model ClinicaHeridasPaciente {
  id                 String   @id @default(uuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  /// Referencia opaca y estable del paciente en el Bridge.
  pacienteRef        String   @unique

  /// driveItemId de la carpeta del paciente dentro de ClinicaDeHeridas.
  /// Es un identificador opaco de Graph: no contiene el documento.
  carpetaDriveItemId String?

  seguimientos       ClinicaHeridas[]
}

/// Un seguimiento de la herida. Un paciente acumula N seguimientos numerados
/// de forma consecutiva, cada uno con sus propias medidas y sus propias fotos.
model ClinicaHeridas {
  id                     String   @id @default(uuid())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  /// Consecutivo dentro del paciente: 1, 2, 3... Da nombre a la carpeta
  /// "Seguimiento N" de SharePoint y ordena el historico.
  numero                 Int

  pacienteRef            String
  paciente               ClinicaHeridasPaciente @relation(fields: [pacienteRef], references: [pacienteRef])

  // Caracteristicas de la herida
  origen                 String
  ubicacion              String
  diametroVerticalCm     Float
  diametroHorizontalCm   Float
  profundidadCm          Float
  fondo                  String
  lecho                  String
  tejido                 String

  /// Opcionales en la base porque hay seguimientos anteriores a la creacion de
  /// estos campos. La API los exige en todo seguimiento nuevo.
  cavitacionTunelizacion String?
  pielPerilesional       String?

  // Exudado: dejo de ser un campo unico y pasa a describirse en dos.
  exudadoCantidad        String
  exudadoCaracteristicas String

  /// driveItemId de la carpeta "Seguimiento N" en SharePoint.
  carpetaDriveItemId     String?

  usuarioId              String
  usuario                User     @relation(fields: [usuarioId], references: [id])

  fotos                  ClinicaHeridasFoto[]

  @@unique([pacienteRef, numero])
  @@index([usuarioId, createdAt])
  @@index([createdAt])
  @@index([pacienteRef, createdAt])
}

/// Referencia a una foto de la herida.
///
/// El binario vive EXCLUSIVAMENTE en SharePoint. Aqui solo se guarda su
/// driveItemId (opaco), el nombre del archivo y su tipo MIME, que es lo minimo
/// para volver a abrirla desde el portal.
model ClinicaHeridasFoto {
  id            String         @id @default(uuid())
  createdAt     DateTime       @default(now())

  seguimientoId String
  seguimiento   ClinicaHeridas @relation(fields: [seguimientoId], references: [id], onDelete: Cascade)

  tipo          TipoFotoHerida
  driveItemId   String
  nombre        String
  mimeType      String?

  @@unique([seguimientoId, tipo])
  @@index([seguimientoId])
}

/// Auditoria tecnica y soporte del rate limiting de las busquedas contra el
/// Bridge. Sigue el mismo patron que `LoginAttempt` (no hay Redis en este
/// despliegue, el estado vive en PostgreSQL).
///
/// PRIVACIDAD: aqui NO se guarda documento, nombre, HMAC ni payload. Solo
/// metadatos tecnicos: quien consulto, desde donde, cuando, cuanto tardo y con
/// que codigo HTTP termino.
model ClinicaHeridasConsulta {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  usuarioId  String
  usuario    User     @relation(fields: [usuarioId], references: [id])
  ip         String
  requestId  String
  ok         Boolean  @default(false)
  status     Int
  durationMs Int

  @@index([usuarioId, createdAt])
  @@index([ip, createdAt])
}

model RondaIntramural {
  id                     String             @id @default(uuid())
  pacienteNombre         String
  pacienteTipoDoc        TipoDocumentoRonda
  pacienteDocumento      String
  ips                    String
  cie10Codigo            String
  diagnosticoDescriptivo String
  ingresoEfectivo        Boolean?
  causaNoIngreso         String?
  observacionNoIngreso   String?
  otros                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  usuarioId              String
  usuario                User               @relation(fields: [usuarioId], references: [id])
  medicamentos           RondaMedicamento[]

  @@index([usuarioId, createdAt])
  @@index([createdAt])
  @@index([ips])
}

model RondaMedicamento {
  id                    String           @id @default(uuid())
  nombre                String
  orden                 Int
  rondaId               String
  ronda                 RondaIntramural @relation(fields: [rondaId], references: [id], onDelete: Cascade)

  @@index([rondaId])
}

model Cie10Catalogo {
  codigo       String @id
  descripcion  String
}

model MedicamentoCatalogo {
  id      String @id @default(uuid())
  nombre  String @unique
}

model Boletin {
  id                  String              @id @default(uuid())
  titulo              String
  contenidoHtml       String?

  // Adjunto opcional (se sube a SharePoint y se sirve desde el portal)
  adjuntoTipo         BoletinAdjuntoTipo?
  adjuntoDriveItemId  String?
  adjuntoNombre       String?
  adjuntoMimeType     String?

  publicado           Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  autorId             String
  autor               User                @relation(fields: [autorId], references: [id])
}

model Consentimiento {
  id         String   @id @default(uuid())
  cedula     String
  fechaHora  DateTime
  archivoUrl String
  aceptado   Boolean  @default(true) // NUEVO CAMPO: true = aceptado, false = rechazado
  createdAt  DateTime @default(now())
  usuarioId  String
  usuario    User     @relation(fields: [usuarioId], references: [id])
}

model Novedad {
  id                 String        @id @default(uuid())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Snapshot del prestador (para auditoría / histórico)
  prestadorNombre     String
  prestadorCedula     String
  prestadorProfesion  Profesion
  prestadorTelefono   String?

  zona               Zona?
  categoria          CategoriaNovedad

  // Campos para novedad con paciente
  pacienteNombre     String?
  pacienteTipoDoc    TipoDocumento?
  pacienteDocumento  String?
  tipoPaciente       TipoNovedadPaciente?
  medicamentoNombre1 String?
  medicamentoNombre2 String?
  medicamentoNombre3 String?
  fotoIngresoDomicilioUrl       String?
  fotoIngresoDomicilioDriveItemId String?
  fotoIngresoDomicilioNombre    String?
  fotoIngresoDomicilioMimeType  String?
  fotoRutaEvidenciaUrl          String?
  fotoRutaEvidenciaDriveItemId  String?
  fotoRutaEvidenciaNombre       String?
  fotoRutaEvidenciaMimeType     String?
  adjuntoFarmaciaUrl            String?
  adjuntoFarmaciaDriveItemId    String?
  adjuntoFarmaciaNombre         String?
  adjuntoFarmaciaMimeType       String?

  // Campos para novedad en ruta
  tipoRuta           TipoNovedadRuta?
  tipoFarmacia       TipoNovedadFarmacia?

  // Campos para novedad de terapias ambulatorias
  tipoTerapiaAmbulatoria               TipoNovedadTerapiaAmbulatoria?
  adjuntoTerapiaAmbulatoriaUrl         String?
  adjuntoTerapiaAmbulatoriaDriveItemId String?
  adjuntoTerapiaAmbulatoriaNombre      String?
  adjuntoTerapiaAmbulatoriaMimeType    String?

  descripcion        String
  esClinicaHeridas   Boolean        @default(false)
  ubicacionLatitud   Float?
  ubicacionLongitud  Float?

  // Gestión (solo técnico/administrativo)
  estado             EstadoNovedad  @default(PENDIENTE)
  prioridad          Prioridad      @default(MEDIA)
  responsableGestion ResponsableGestion?
  asignadoA          String?
  notasInternas      String?
  respuestaPrestador String?
  farmaciaCorregida  Boolean        @default(false)
  farmaciaCorregidaAt DateTime?
  notificacionFarmaciaSinGestionAt DateTime?

  usuarioId          String
  usuario            User          @relation(fields: [usuarioId], references: [id])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  username  String // username intentado (normalizado a minusculas)
  ip        String
  userAgent String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
}

/// Las cuatro tomas fotograficas de cada seguimiento.
enum TipoFotoHerida {
  PLANO_GENERAL
  MEDIDA_VERTICAL
  MEDIDA_HORIZONTAL
  LATERAL
}

enum Rol {
  ESPECIALISTA
  MEDICO_RONDA
  ADMINISTRATIVO
  TECNICO
  FARMACIA
  CLINICA_HERIDAS
}

enum TipoDocumentoRonda {
  CC
  RC
  PA
  CE
  TI
  PE
  PPT
}

enum Profesion {
  AUXILIAR_ENFERMERIA
  ENFERMERIA
  MEDICO
  FISIOTERAPIA
  FONOAUDIOLOGIA
  NUTRICION
  OTRO
}

enum Zona {
  NORTE
  SUR
  OCCIDENTE
  ORIENTE
  ORIENTE_ANTIOQUENO
}

enum CategoriaNovedad {
  PACIENTE
  RUTA
  PROCESO_FARMACEUTICO
  LLAMADA_URGENTE
  TERAPIAS_AMBULATORIAS
}

enum TipoDocumento {
  CC
  TI
  CE
  PA
  PPT
  RC
  NUIP
}

enum TipoNovedadPaciente {
  ERCA
  CATETER_PICC
  DATOS_ERRADOS
  ACTUALIZACION_DATOS
  AGENDAMIENTO
  FALLECIMIENTO
  HOSPITALIZACION
  ALTA_TARDIA
  INICIO_TRATAMIENTO_PRIORITARIO
  RETRASO_INICIO_TRATAMIENTO
  PROBABLE_REACCION_ALERGICA
  DOBLE_PRESTADOR
  RELACIONAMIENTO
  IMPOSIBILIDAD_CONTACTAR_PACIENTE
  IMPOSIBILIDAD_INGRESAR_DOMICILIO
  PRORROGA_CAMBIO_ADICION_TRATAMIENTO
  OTRA
}

enum TipoNovedadRuta {
  INCAPACIDAD
  ACCIDENTE
  CIERRE_VIAL
  NO_REALIZO_RUTA
}

enum TipoNovedadFarmacia {
  ERROR_KARDEX
  ERROR_REQUISICION
  ERROR_AUTORIZACION
  ERROR_AUXILIAR_ASIGNADO
  ERROR_FORMULA
  ERROR_TODOS_LOS_DOCUMENTOS
}

enum TipoNovedadTerapiaAmbulatoria {
  PACIENTE_TERAPIA_AMBULATORIA
  VALIDACION_PERTINENCIA_TERAPIAS
  CONSIDERACION_INGRESO_PROGRAMA_CRONICO
  PROBABLE_AGUDIZACION
  SOLICITUD_EXTENSION_TERAPIAS
  CAMBIO_FRECUENCIA_TERAPIAS
  VISITA_FALLIDA
}

enum EstadoNovedad {
  PENDIENTE
  RESUELTA
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
}

enum ResponsableGestion {
  ADMISIONES
  ANALISTA_ASISTENCIAL
  CLINICA_HERIDAS
  DIRECCION_ASISTENCIAL
}

enum BoletinAdjuntoTipo {
  IMAGE
  PDF
}
